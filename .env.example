# Separate credentials for each role. Default provider: Groq.
# Chatbot and judge use --provider; user uses --user-provider (defaults to --provider).
# Get Groq keys at https://console.groq.com/keys
# Or OpenRouter keys at https://openrouter.ai/keys
ASSISTANT_API_KEY=
USER_API_KEY=
EVALUATOR_API_KEY=

# Google Gemini API Key (Get at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
